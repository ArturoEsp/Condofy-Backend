// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/core/infrastructure/persistence/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RESIDENT
  STAND
}

enum ResidentType {
  PRIMARY
  TENANT
  FAMILY_MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MaintenanceChargeStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  SPEI
  CARD
  CHECK
}

enum AccountMovementType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  CREDIT
  LATE_FEE
}

enum AuthorizationType {
  ONE_TIME
  DATE_RANGE
  PERMANENT
}

enum AuthorizationStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  USED
}

enum EntryType {
  ENTRY
  EXIT
}

enum VisitorCategory {
  FAMILY
  FRIEND
  DELIVERY
  SERVICE
  EMPLOYEE
  OTHER
}

enum ParcelStatus {
  IN_CUSTODY
  DELIVERED
  RETURNED
}

enum CourierCompany {
  AMAZON
  MERCADO_LIBRE
  DHL
  FEDEX
  ESTAFETA
  UBER_EATS
  RAPPI
  DIDI
  CORREOS_DE_MEXICO
  OTHER
}

enum GeneralProviderCategory {
  WATER
  GAS
  GARDENING
  TRASH
  MAINTENANCE
  OTHER
}

enum GeneralProviderStatus {
  INSIDE
  EXITED
}

model Condominium {
  id                      String                  @id @default(uuid())
  key                     String                  @unique
  name                    String
  description             String?
  googleMapsUrl           String?
  address                 String?
  contactPhone            String?
  contactEmail            String?
  houses                  House[]
  admins                  User[]
  residentProfiles        ResidentProfile[]
  maintenanceCharges      MaintenanceCharge[]
  parcels                 ParcelDelivery[]
  generalProviderAccesses GeneralProviderAccess[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model User {
  id                        String                  @id @default(uuid())
  email                     String                  @unique
  passwordHash              String
  firstName                 String?
  lastName                  String?
  phone                     String?
  role                      UserRole                @default(RESIDENT)
  status                    UserStatus              @default(PENDING)
  isEmailVerified           Boolean                 @default(false)
  residentProfile           ResidentProfile?
  payments                  Payment[]
  userSessions              UserSession[]
  condominium               Condominium?            @relation(fields: [condominiumId], references: [id], onDelete: SetNull)
  condominiumId             String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  accessLogs                AccessLog[]
  parcelsReceived           ParcelDelivery[]        @relation("ParcelReceivedBy")
  parcelsDelivered          ParcelDelivery[]        @relation("ParcelDeliveredBy")
  providerEntriesRegistered GeneralProviderAccess[] @relation("ProviderEntryGuard")
  providerExitsRegistered   GeneralProviderAccess[] @relation("ProviderExitGuard")
  passwordResetTokens       PasswordResetToken[]
  pushSubscriptions         PushSubscription[]

  @@index([condominiumId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime BigInt?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model House {
  id                 String              @id @default(uuid())
  condominiumId      String
  condominium        Condominium         @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  houseNumber        String
  tower              String?
  residents          ResidentProfile[]
  maintenanceCharges MaintenanceCharge[]
  houseAccount       HouseAccount?
  accountMovements   AccountMovement[]
  visitors           Visitor[]
  houseConfiguration HouseConfiguration?
  parcels            ParcelDelivery[]
  isDisabled         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([condominiumId, houseNumber])
}

model HouseConfiguration {
  id              String   @id @default(uuid())
  house           House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId         String   @unique
  hideAccessAfter Int?     @default(30)
  updatedAt       DateTime @updatedAt
}

model ResidentProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  condominiumId   String
  condominium     Condominium  @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  houseId         String
  house           House        @relation(fields: [houseId], references: [id], onDelete: Restrict)
  residentType    ResidentType
  canCreateVisits Boolean      @default(true)
  firstName       String
  lastName        String
  phone           String?
  comments        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([condominiumId])
  @@index([houseId])
}

// Visitors and Access
model Visitor {
  id             String                @id @default(uuid())
  house          House                 @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId        String
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  photo          String?
  category       VisitorCategory
  vehiclePlate   String?
  notes          String?
  authorizations AccessAuthorization[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([houseId])
  @@index([category])
}

model AccessAuthorization {
  id           String              @id @default(uuid())
  index        Int                 @default(autoincrement())
  visitor      Visitor             @relation(fields: [visitorId], references: [id])
  visitorId    String
  qrCode       String              @unique
  vehiclePlate String?
  type         AuthorizationType
  status       AuthorizationStatus
  validFrom    DateTime
  validUntil   DateTime?
  maxEntries   Int?
  usedEntries  Int                 @default(0)
  notes        String?
  logs         AccessLog[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([visitorId])
  @@index([status])
  @@index([validFrom, validUntil])
}

model AccessLog {
  id                    String              @id @default(uuid())
  authorization         AccessAuthorization @relation(fields: [accessAuthorizationId], references: [id], onDelete: Cascade)
  accessAuthorizationId String
  entryType             EntryType
  observations          String?
  userAccept            User                @relation(fields: [userAcceptId], references: [id], onDelete: Cascade)
  userAcceptId          String
  date                  DateTime            @default(now())

  @@index([accessAuthorizationId])
  @@index([userAcceptId])
  @@index([date])
}

model ParcelDelivery {
  id               String         @id @default(uuid())
  condominiumId    String
  condominium      Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  houseId          String
  house            House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  courier          CourierCompany
  customCourier    String?
  trackingNumber   String?
  packageCount     Int            @default(1)
  photoUrl         String?
  notes            String?
  pickupCode       String
  status           ParcelStatus   @default(IN_CUSTODY)
  receivedAt       DateTime       @default(now())
  receivedById     String
  receivedBy       User           @relation("ParcelReceivedBy", fields: [receivedById], references: [id])
  notifiedAt       DateTime?
  notificationSent Boolean        @default(false)
  deliveredAt      DateTime?
  deliveredById    String?
  deliveredBy      User?          @relation("ParcelDeliveredBy", fields: [deliveredById], references: [id])
  deliveredToName  String?
  deliveryNotes    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([condominiumId, status])
  @@index([houseId, status])
  @@index([pickupCode])
  @@index([receivedAt])
}

model GeneralProviderAccess {
  id            String                  @id @default(uuid())
  condominiumId String
  condominium   Condominium             @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  name          String
  category      GeneralProviderCategory
  driverName    String?
  vehiclePlate  String?
  companyPhone  String?
  notes         String?
  status        GeneralProviderStatus   @default(INSIDE)

  enteredAt    DateTime @default(now())
  entryGuardId String
  entryGuard   User     @relation("ProviderEntryGuard", fields: [entryGuardId], references: [id])

  exitedAt    DateTime?
  exitGuardId String?
  exitGuard   User?     @relation("ProviderExitGuard", fields: [exitGuardId], references: [id])
  exitNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominiumId, status])
  @@index([enteredAt])
}

// Account model to manage condominium's financial accounts
model HouseAccount {
  id             String   @id @default(uuid())
  houseId        String   @unique
  currentBalance Decimal  @db.Decimal(12, 2)
  house          House    @relation(fields: [houseId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AccountMovement {
  id           String              @id @default(uuid())
  houseId      String
  house        House               @relation(fields: [houseId], references: [id])
  type         AccountMovementType
  description  String
  amount       Decimal             @db.Decimal(12, 2)
  movementDate DateTime
  createdAt    DateTime            @default(now())

  @@index([houseId])
  @@index([movementDate])
}

// Payment model to track maintenance charges and payments
model MaintenanceCharge {
  id                  String                  @id @default(uuid())
  condominiumId       String
  houseId             String
  condominium         Condominium             @relation(fields: [condominiumId], references: [id])
  house               House                   @relation(fields: [houseId], references: [id])
  concept             String
  amount              Decimal                 @db.Decimal(12, 2)
  dueDate             DateTime
  status              MaintenanceChargeStatus @default(PENDING)
  paidAmount          Decimal                 @default(0) @db.Decimal(12, 2)
  notes               String?
  payments            Payment[]
  maintenancePeriod   MaintenancePeriod?      @relation(fields: [maintenancePeriodId], references: [id], onDelete: Restrict)
  maintenancePeriodId String?
  lateFees            LateFee[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([condominiumId])
  @@index([houseId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id                  String            @id @default(uuid())
  maintenanceChargeId String
  maintenanceCharge   MaintenanceCharge @relation(fields: [maintenanceChargeId], references: [id])
  amount              Decimal           @db.Decimal(12, 2)
  paymentDate         DateTime
  paymentMethod       PaymentMethod
  reference           String?
  observations        String?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([maintenanceChargeId])
  @@index([createdById])
  @@index([paymentDate])
}

model MaintenancePeriod {
  id            String              @id @default(uuid())
  condominiumId String
  name          String
  year          Int
  month         Int
  amount        Decimal             @db.Decimal(12, 2)
  generatedAt   DateTime            @default(now())
  charges       MaintenanceCharge[]
  createdAt     DateTime            @default(now())

  @@index([condominiumId])
}

model LateFee {
  id                  String            @id @default(uuid())
  maintenanceChargeId String
  maintenanceCharge   MaintenanceCharge @relation(fields: [maintenanceChargeId], references: [id])
  amount              Decimal           @db.Decimal(12, 2)
  reason              String
  createdAt           DateTime          @default(now())

  @@index([maintenanceChargeId])
}
