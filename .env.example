# ========================================================
# APP CONFIGURATION
# ========================================================
APP_PORT=3000
APP_ENV=development # development | production
APP_SECRET=your_super_secret_jwt_key_min_32_chars
APP_JWT_EXPIRED=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# CORS: URLs permitidas para consumir el API (separadas por coma)
# En desarrollo: http://localhost:5173,http://127.0.0.1:5173
# En producción (Hostinger): https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# URL base del frontend para enlaces en correos electrónicos (Magic Links, etc.)
FRONTEND_URL=http://localhost:5173

# ========================================================
# MAIL CONFIGURATION (Resend)
# ========================================================
# En local puedes dejarlo vacío para imprimir los enlaces en consola, o poner tu API key de prueba
RESEND_API_KEY=re_your_api_key_here
# En pruebas con Resend usa: onboarding@resend.dev. En producción tu dominio verificado:
RESEND_FROM_EMAIL="Condofy <onboarding@resend.dev>"

# ========================================================
# STORAGE CONFIGURATION (Cloudflare R2 / S3)
# ========================================================
# Endpoint de Cloudflare R2 (https://<ACCOUNT_ID>.r2.cloudflarestorage.com) o DigitalOcean Spaces
STORAGE_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key
STORAGE_BUCKET_NAME=condofy-storage
STORAGE_REGION=auto
# URL pública o dominio personalizado si el bucket o carpeta es público (ej. https://media.condofy.com o https://pub-<hash>.r2.dev)
STORAGE_PUBLIC_URL=



# ========================================================
# COOKIE & SECURITY SETTINGS
# ========================================================
# COOKIE_SECURE: true si tienes HTTPS (producción), false en desarrollo HTTP local
COOKIE_SECURE=false

# COOKIE_SAME_SITE:
# - lax: recomendado si frontend y backend comparten el mismo dominio raíz (ej. tudominio.com y api.tudominio.com)
# - none: obligatorio si frontend y backend están en dominios completamente distintos (requiere COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# COOKIE_DOMAIN:
# Si el frontend está en app.tudominio.com y el backend en api.tudominio.com, usa: .tudominio.com
# Si están en dominios completamente distintos, déjalo vacío o comentado.
# COOKIE_DOMAIN=.tudominio.com

# ========================================================
# DOMINIO / PROXY REVERSO (DigitalOcean + Caddy)
# ========================================================
# En local usa: localhost
# En DigitalOcean pon tu subdominio (ej: api.tudominio.com) para HTTPS automático de Let's Encrypt
DOMAIN=localhost

# ========================================================
# ADMIN DE INICIO (para prisma seed)
# ========================================================
APP_ADMIN_EMAIL=admin@condofy.com
APP_ADMIN_PASSWORD=change_this_secure_password_123

# ========================================================
# DATABASE CONFIGURATION
# ========================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=condofy

# ========================================================
# PRISMA CONFIGURATION
# ========================================================
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/condofy?schema=public"
# En Producción (Docker Compose lo arma automáticamente con connection_limit y pool_timeout óptimos):
# DATABASE_URL="postgresql://condofy_user:password@postgres:5432/condofy_db?schema=public&connection_limit=15&pool_timeout=10"

# ========================================================
# WEB PUSH / VAPID CONFIGURATION
# ========================================================
# Genera tus claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu_clave_publica_aqui
VAPID_PRIVATE_KEY=tu_clave_privada_aqui
VAPID_SUBJECT="mailto:contacto@condofy.com.mx"
